# Sign-in (Stack Auth): the same project the website uses, so one account works on both. Public values.
VITE_STACK_PROJECT_ID=
VITE_STACK_PUBLISHABLE_CLIENT_KEY=
# Alternative to the two above: the same JSON the website uses.
AUTH_PROVIDERS=
# The website. Signed-out visitors are sent to its sign-in; addresses the Hub does not serve open there.
VITE_WEBSITE_URL=https://citizenbank.co.ls
