# Sign-in (Stack Auth): the same project the website uses, so one account works on both. Public values.
VITE_STACK_PROJECT_ID=
VITE_STACK_PUBLISHABLE_CLIENT_KEY=
# The website. Signed-out visitors are sent to its sign-in and come straight back; any page the Hub does not own opens there.
VITE_WEBSITE_URL=https://citizenbank.co.ls
# Sign-in config the carved-out screens' auth layer reads (same Stack project values as above), as JSON.
AUTH_PROVIDERS=
