{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://citizen-website-demo.vercel.app/api/:path*"
    },
    {
      "source": "/:path((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
